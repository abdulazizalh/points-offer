# ---------------------------------------------------------------
# MASAR environment. Copy to .env.local. Never commit real values.
# Anything without NEXT_PUBLIC_ stays on the server.
# ---------------------------------------------------------------

# "demo" (default): local demo engine, clearly labelled demo data.
# "supabase": use the Supabase backend in /supabase (requires keys below).
NEXT_PUBLIC_DATA_MODE=demo

# Supabase (public anon key is safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used by API routes for notification fan-out
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps (restrict this key by HTTP referrer in Google Cloud console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (web push)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# SMS (Twilio-compatible). Leave empty to keep SMS disabled.
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# WhatsApp Business Cloud API. Leave empty to keep WhatsApp disabled.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=masar_queue_update
